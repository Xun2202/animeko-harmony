@@ -201,6 +204,10 @@ internal fun MediaCacheEngineKey.isInProcess(): Boolean = this == MediaCacheEngi
 internal data class HttpDownloadActivity(
     val taskCount: Int,
     val downloadSpeed: FileSize,
+    /** Overall progress of the active downloads in percent, `null` while none of them reports one. */
+    val progress: Int? = null,
+    /** "<subject> - <episode>" of the first active download, for the expanded notification. */
+    val currentItem: String? = null,
 )
 
 /**
@@ -218,6 +225,33 @@ internal fun httpDownloadActivity(manager: MediaDownloadManager): Flow<HttpDownl
                 downloadSpeed = active
                     .sumOf { snapshot -> snapshot.downloadSpeed.takeIf { !it.isUnspecified }?.inBytes ?: 0L }
                     .bytes,
+                progress = active.overallProgressPercent(),
+                currentItem = active.firstOrNull()?.let { snapshot ->
+                    val metadata = snapshot.metadata
+                    val subject = metadata.subjectNameCN ?: metadata.subjectNames.firstOrNull()
+                    val episode = "${metadata.episodeSort} ${metadata.episodeName}".trim()
+                    listOfNotNull(subject, episode.takeIf { it.isNotEmpty() }).joinToString(" - ")
+                },
             )
         }
         .distinctUntilChanged()
+
+/**
+ * Weighted by size where every download knows its total size, otherwise the plain mean of the
+ * downloads that report a progress at all; `null` when none does (e.g. HLS streams without a
+ * known length).
+ */
+internal fun List<DownloadSnapshot>.overallProgressPercent(): Int? {
+    val reporting = mapNotNull { snapshot ->
+        snapshot.progress.getOrNull()?.let { fraction -> fraction to snapshot.totalSize }
+    }
+    if (reporting.isEmpty()) return null
+
+    val fraction = if (reporting.all { (_, size) -> !size.isUnspecified && size.inBytes > 0 }) {
+        val total = reporting.sumOf { (_, size) -> size.inBytes }
+        reporting.sumOf { (progress, size) -> (progress * size.inBytes).toDouble() } / total
+    } else {
+        reporting.sumOf { (progress, _) -> progress.toDouble() } / reporting.size
+    }
+    return (fraction * 100).toInt().coerceIn(0, 100)
+}
