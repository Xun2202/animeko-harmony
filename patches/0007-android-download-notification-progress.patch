+            working?.detail?.let { setStyle(Notification.BigTextStyle().bigText("$contentText\n$it")) }
             setSmallIcon(notificationAppearance.icon)
             setContentIntent(openActivityAction)
             setActions(
@@ -281,9 +288,16 @@ sealed class NotificationDisplayStrategy(val downloadSpeed: FileSize, val upload
         uploadSpeed: FileSize
     ) : NotificationDisplayStrategy(downloadSpeed, uploadSpeed)
 
+    /**
+     * @param progress overall progress in percent (0..100), `null` when the service cannot tell.
+     * @param detail the item being downloaded, shown as a second line when the notification is
+     * expanded; `null` to show the plain single-line notification.
+     */
     class Working(
         downloadSpeed: FileSize,
         uploadSpeed: FileSize,
         val taskCount: Int,
+        val progress: Int? = null,
+        val detail: String? = null,
     ) : NotificationDisplayStrategy(downloadSpeed, uploadSpeed)
 }
