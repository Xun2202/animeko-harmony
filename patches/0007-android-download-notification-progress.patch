                             stats.downloadSpeed.bytes,
                             stats.uploadSpeed.bytes,
                             downloadingSessionCount,
+                            // Harmony: overall progress of the open sessions, like the HTTP cache notification.
+                            progress = if (stats.totalSize > 0) {
+                                (stats.downloadProgress * 100).toInt().coerceIn(0, 100)
+                            } else {
+                                null
+                            },
                         )
                     } else {
                         NotificationDisplayStrategy.Idle(stats.downloadSpeed.bytes, stats.uploadSpeed.bytes)
diff --git a/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/HttpCacheService.kt b/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/HttpCacheService.kt
index 1c5e5fd..9c27e94 100644
