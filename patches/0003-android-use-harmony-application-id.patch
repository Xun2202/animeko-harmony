From 1f554b316d537ff122648a0b480cec6a8740ffaa Mon Sep 17 00:00:00 2001
From: Xun2202 <xun2202@users.noreply.github.com>
Date: Thu, 1 Oct 2026 06:00:22 +0000
Subject: [PATCH] android: use a dedicated applicationId for the Harmony build
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

HarmonyOS 卓易通 refuses to install APKs whose package name is in its
catalogue but whose signature does not match the official one, and the
system then falls back to 出境易 with "暂不支持安装该应用".

Switch the Harmony build to the package name `me.him188.ani.harmony`
so it is treated as an independent app. This also lets it coexist with
the official Animeko install. The FileProvider authority derived from
AndroidBuildConfig.APP_APPLICATION_ID is updated to match; the launcher
label stays "Animeko".
---
 app/android/build.gradle.kts                      | 2 +-
 app/shared/src/androidMain/res/values/strings.xml | 2 +-
 utils/build-config/build.gradle.kts               | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/app/android/build.gradle.kts b/app/android/build.gradle.kts
index 5a76277..f5ccded 100644
--- a/app/android/build.gradle.kts
+++ b/app/android/build.gradle.kts
@@ -36,7 +36,7 @@ android {
     namespace = "me.him188.ani.android"
     compileSdk = getIntProperty("android.compile.sdk")
     defaultConfig {
-        applicationId = "me.him188.ani"
+        applicationId = "me.him188.ani.harmony"
         minSdk = getIntProperty("android.min.sdk")
         targetSdk = getIntProperty("android.compile.sdk")
         versionCode = getIntProperty("android.version.code")
diff --git a/app/shared/src/androidMain/res/values/strings.xml b/app/shared/src/androidMain/res/values/strings.xml
index bbf2153..a2d6486 100644
--- a/app/shared/src/androidMain/res/values/strings.xml
+++ b/app/shared/src/androidMain/res/values/strings.xml
@@ -9,7 +9,7 @@
 
 <resources>
     <string name="app_name">Animeko</string>
-    <string name="app_package" translatable="false">me.him188.ani</string>
+    <string name="app_package" translatable="false">me.him188.ani.harmony</string>
     <string name="service_torrent_engine_description">Animeko BT engine foreground service</string>
     <string name="app_service_title_text_idle">No download tasks</string>
     <string name="app_service_title_text_working">Downloading %1$d resource(s)</string>
diff --git a/utils/build-config/build.gradle.kts b/utils/build-config/build.gradle.kts
index 7d74dcc..4ac26fd 100644
--- a/utils/build-config/build.gradle.kts
+++ b/utils/build-config/build.gradle.kts
@@ -22,7 +22,7 @@ android {
 
     buildTypes {
         release {
-            buildConfigField("String", "APP_APPLICATION_ID", "\"${idGroup}\"")
+            buildConfigField("String", "APP_APPLICATION_ID", "\"${idGroup}.harmony\"")
         }
 
         debug {
-- 
2.43.0

