+package me.him188.ani.app.ui.update
+
+import io.ktor.client.HttpClient
+import io.ktor.client.request.get
+import io.ktor.client.request.header
+import io.ktor.client.request.parameter
+import io.ktor.client.statement.bodyAsText
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import me.him188.ani.utils.platform.Arch
+
+/**
+ * Update source for the unofficial HarmonyOS (卓易通) builds.
+ *
+ * Fork builds carry a version name like `6.2.0-harmony.1`. The official update server treats that as a
+ * pre-release of `6.2.0` and offers the official `6.2.0` APK, which cannot be installed over a build with a
+ * different signing key. Such builds therefore check the fork's own GitHub releases instead.
+ */
+internal const val HARMONY_FORK_REPO = "Xun2202/animeko-harmony"
+
+internal data class HarmonyForkVersion(
+    val major: Int,
+    val minor: Int,
+    val patch: Int,
+    val harmony: Int,
+) : Comparable<HarmonyForkVersion> {
+    val name: String get() = "$major.$minor.$patch-harmony.$harmony"
+
+    override fun compareTo(other: HarmonyForkVersion): Int = compareValuesBy(
+        this, other,
+        { it.major }, { it.minor }, { it.patch }, { it.harmony },
+    )
+
+    companion object {
+        private val REGEX = Regex("""^v?(\d+)\.(\d+)\.(\d+)-harmony\.(\d+)$""")
+
+        fun parse(version: String): HarmonyForkVersion? {
+            val match = REGEX.matchEntire(version.trim()) ?: return null
+            val (major, minor, patch, harmony) = match.destructured
+            return HarmonyForkVersion(major.toInt(), minor.toInt(), patch.toInt(), harmony.toInt())
+        }
+    }
+}
+
+internal fun harmonyForkReleasePageUrl(version: HarmonyForkVersion): String =
+    "https://github.com/$HARMONY_FORK_REPO/releases/tag/v${version.name}"
+
+@Serializable
+internal class GitHubReleaseAsset(
+    val name: String,
+    @SerialName("browser_download_url") val browserDownloadUrl: String,
+)
+
+@Serializable
+internal class GitHubRelease(
+    @SerialName("tag_name") val tagName: String,
+    val body: String? = null,
+    @SerialName("published_at") val publishedAt: String? = null,
+    val draft: Boolean = false,
+    val prerelease: Boolean = false,
+    val assets: List<GitHubReleaseAsset> = emptyList(),
+)
+
+private val githubJson = Json { ignoreUnknownKeys = true }
+
+/**
+ * Returns the newest fork release newer than [current], or `null` when [current] is already the latest.
+ */
+internal suspend fun HttpClient.getHarmonyForkLatestVersion(
+    current: HarmonyForkVersion,
+    arch: Arch,
+): NewVersion? {
+    val releases = get("https://api.github.com/repos/$HARMONY_FORK_REPO/releases") {
+        parameter("per_page", 30)
+        header("Accept", "application/vnd.github+json")
+    }.bodyAsText().let {
+        githubJson.decodeFromString(ListSerializer(GitHubRelease.serializer()), it)
+    }
+
+    val newer = releases.asSequence()
+        .filter { !it.draft }
+        .mapNotNull { release -> HarmonyForkVersion.parse(release.tagName)?.let { it to release } }
+        .filter { (version, _) -> version > current }
+        .sortedBy { (version, _) -> version }
+        .toList()
+
+    val (latestVersion, latest) = newer.lastOrNull() ?: return null
+    return NewVersion(
+        name = latestVersion.name,
+        changelogs = newer.asReversed().take(10).map { (version, release) ->
+            Changelog(version.name, formatGitHubDate(release.publishedAt), release.body.orEmpty())
+        },
+        downloadUrlAlternatives = selectApkAssets(latest.assets, arch),
+        publishedAt = formatGitHubDate(latest.publishedAt),
+    )
+}
+
+/**
+ * Picks the APK for this device first and the universal APK as a fallback. Release assets are named
+ * `ani-<version>-<abi>.apk`, matching the official release layout.
+ */
+internal fun selectApkAssets(assets: List<GitHubReleaseAsset>, arch: Arch): List<String> {
+    val abi = when (arch) {
+        Arch.ARMV8A, Arch.AARCH64 -> "arm64-v8a"
+        Arch.ARMV7A -> "armeabi-v7a"
+        Arch.X86_64 -> "x86_64"
+    }
+    val apks = assets.filter { it.name.endsWith(".apk", ignoreCase = true) }
+    val exact = apks.filter { it.name.endsWith("-$abi.apk", ignoreCase = true) }
+    val universal = apks.filter { it.name.endsWith("-universal.apk", ignoreCase = true) }
+    return (exact + universal).map { it.browserDownloadUrl }.distinct()
+}
+
+// GitHub returns ISO-8601 timestamps; the date part is all the UI shows.
+private fun formatGitHubDate(publishedAt: String?): String = publishedAt.orEmpty().take(10)
