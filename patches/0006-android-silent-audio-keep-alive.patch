+package me.him188.ani.app.domain.torrent.service
+
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.Build
+import kotlinx.coroutines.CancellationException
+import me.him188.ani.utils.logging.info
+import me.him188.ani.utils.logging.logger
+import me.him188.ani.utils.logging.warn
+import java.io.File
+
+/**
+ * Loops a silent PCM buffer for as long as the owning service runs.
+ *
+ * HarmonyOS 卓易通 suspends an Android app's process a few seconds after it leaves the foreground even
+ * when it holds a `dataSync` foreground service, a wake lock and a battery-optimisation exemption
+ * (verified on-device, see HARMONY.md). Audio output is the one activity the host treats as a reason to
+ * keep the container running, since background music is the main use case for it. The track is
+ * written once and looped by the audio HAL in [AudioTrack.MODE_STATIC], so it costs no CPU; audio focus
+ * is deliberately not requested, so other apps' playback is not ducked or paused.
+ */
+internal class SilentAudioKeepAlive {
+    private val logger = logger<SilentAudioKeepAlive>()
+    private var track: AudioTrack? = null
+
+    fun start() {
+        if (track != null) return
+        var newTrack: AudioTrack? = null
+        try {
+            val minBuffer = AudioTrack.getMinBufferSize(SAMPLE_RATE, CHANNEL, ENCODING)
+            check(minBuffer > 0) { "AudioTrack returned invalid minimum buffer size: $minBuffer" }
+            val bufferSize = maxOf(minBuffer, SAMPLE_RATE * BYTES_PER_FRAME) // >= 1 second
+            val builtTrack = AudioTrack.Builder()
+                .setAudioAttributes(
+                    AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                        .build(),
+                )
+                .setAudioFormat(
+                    AudioFormat.Builder()
+                        .setSampleRate(SAMPLE_RATE)
+                        .setEncoding(ENCODING)
+                        .setChannelMask(CHANNEL)
+                        .build(),
+                )
+                .setBufferSizeInBytes(bufferSize)
+                .setTransferMode(AudioTrack.MODE_STATIC)
+                .build()
+            newTrack = builtTrack
+
+            val silence = ByteArray(bufferSize)
+            val bytesWritten = builtTrack.write(silence, 0, silence.size)
+            check(bytesWritten == silence.size) { "AudioTrack wrote $bytesWritten of ${silence.size} silent bytes" }
+            check(builtTrack.state == AudioTrack.STATE_INITIALIZED) { "AudioTrack was not initialized after writing static data" }
+            val loopResult = builtTrack.setLoopPoints(0, bufferSize / BYTES_PER_FRAME, -1)
+            check(loopResult == AudioTrack.SUCCESS) { "AudioTrack.setLoopPoints failed: $loopResult" }
+            builtTrack.play()
+            logger.info { "Silent audio keep-alive started. ${describeEnvironment()}" }
+            track = builtTrack
+        } catch (e: CancellationException) {
+            newTrack?.releaseAfterFailedStart()
+            throw e
+        } catch (e: Exception) {
+            newTrack?.releaseAfterFailedStart()
+            logger.warn { "Failed to start silent audio keep-alive: $e" }
+        }
+    }
+
+    fun stop() {
+        val current = track ?: return
+        track = null
+        try {
+            current.stop()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            logger.warn { "Failed to stop silent audio keep-alive: $e" }
+        } finally {
+            try {
+                current.release()
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                logger.warn { "Failed to release silent audio keep-alive: $e" }
+            }
+        }
+        logger.info { "Silent audio keep-alive stopped." }
+    }
+
+    private fun AudioTrack.releaseAfterFailedStart() {
+        try {
+            release()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            logger.warn { "Failed to release partially initialized silent AudioTrack: $e" }
+        }
+    }
+
+    /**
+     * Logged once per start so bug reports show which compatibility layer, if any, we run under.
+     */
+    private fun describeEnvironment(): String {
+        val cgroup = runCatching { File("/proc/self/cgroup").readText().lines().firstOrNull { it.isNotBlank() } }
+            .getOrNull()
+        return "build=${Build.MANUFACTURER}/${Build.BRAND}/${Build.MODEL}/${Build.DEVICE}, sdk=${Build.VERSION.SDK_INT}, cgroup=$cgroup"
+    }
+
+    private companion object {
+        const val SAMPLE_RATE = 8000
+        const val CHANNEL = AudioFormat.CHANNEL_OUT_MONO
+        const val ENCODING = AudioFormat.ENCODING_PCM_16BIT
+        const val BYTES_PER_FRAME = 2
+    }
+}
