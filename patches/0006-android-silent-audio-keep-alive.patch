+++ b/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/HttpCacheService.kt
@@ -39,6 +39,10 @@ import org.koin.core.component.inject
 /**
  * Keeps the app process alive while web-source (HTTP / m3u8) caches are downloading.
  *
+ * Declared as a `mediaPlayback` service and backed by [SilentAudioKeepAlive]: on HarmonyOS 卓易通 a
+ * plain `dataSync` service is suspended seconds after the app leaves the foreground, audio playback
+ * is what the host keeps running.
+ *
  * The HTTP cache engine runs inside the app process, while [AniTorrentService] is declared with
  * `android:process=":torrent_service"` and therefore only protects that other process. Without a
  * foreground service here, the system freezes the app process shortly after it goes to the
@@ -61,6 +65,8 @@ class HttpCacheService : LifecycleService(), KoinComponent {
             .newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Animeko:HttpCacheService")
     }
 
+    private val silentAudio = SilentAudioKeepAlive()
+
     private val notification = ServiceNotification(
         this,
         notificationId = NOTIFICATION_ID,
@@ -129,12 +135,14 @@ class HttpCacheService : LifecycleService(), KoinComponent {
         }
 
         acquireWakeLock()
+        silentAudio.start()
         isRunning.value = true
         return START_STICKY
     }
 
     override fun onDestroy() {
         isRunning.value = false
+        silentAudio.stop()
         releaseWakeLock()
         super.onDestroy()
     }
