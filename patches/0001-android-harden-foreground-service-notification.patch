From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:55:20 +0000
Subject: [PATCH] fix(android): always startForeground for torrent service,
 stop relying on activeNotifications

Rebased for Animeko v6.3.0 while retaining the existing Harmony behavior.
---
 .../torrent/service/AniTorrentService.kt      | 10 +++-
 .../service/AniTorrentServiceStarter.kt       | 46 ++++++++++-----
 .../torrent/service/ServiceNotification.kt    | 57 +++++++++----------
 3 files changed, 69 insertions(+), 44 deletions(-)

diff --git a/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentService.kt b/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentService.kt
index 8abecbf30..8b8c8c07b 100644
--- a/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentService.kt
+++ b/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentService.kt
@@ -163,7 +163,15 @@ sealed class AniTorrentService : LifecycleService() {
             },
         )
 
-        return if (notificationResult) START_STICKY else START_NOT_STICKY
+        if (!notificationResult) {
+            // 系统拒绝了前台启动. 继续运行会错过 startForegroundService 的 startForeground 期限并让本进程崩溃,
+            // 而且没有前台状态的服务一到后台就会被冻结, 下载无法继续. 让 app 在回到前台后重新拉起.
+            logger.info { "Foreground start was refused, stopping AniTorrentService." }
+            stopSelf()
+            return START_NOT_STICKY
+        }
+
+        return START_STICKY
     }
 
 
diff --git a/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentServiceStarter.kt b/app/shared/app-data/src/androidMain/kotlin/domain/torrent/service/AniTorrentServiceStarter.kt
