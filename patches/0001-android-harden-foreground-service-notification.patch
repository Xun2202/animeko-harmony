+import kotlin.time.Duration.Companion.seconds
 
 /**
  * @param onServiceDisconnected optional callback when service disconnected.
@@ -55,6 +58,32 @@ class AniTorrentServiceStarter(
     }
 
     override suspend fun start(): IRemoteAniTorrentEngine {
+        // The startup broadcast normally arrives within milliseconds. If it never does (the service
+        // process crashed before onStartCommand, or the environment delivers cross-process broadcasts
+        // differently from AOSP), fail the attempt so the caller can retry instead of hanging forever.
+        val startupResult = withTimeoutOrNull(STARTUP_BROADCAST_TIMEOUT) { awaitStartupBroadcast() }
+        if (startupResult == null) {
+            logger.warn { "Service startup broadcast not received within $STARTUP_BROADCAST_TIMEOUT." }
+            throw ServiceStartException.StartRespondFailure()
+        }
+
+        val newDeferred = CompletableDeferred<IRemoteAniTorrentEngine>()
+        binderDeferred.value = newDeferred
+
+        val bindResult = context.bindService(
+            Intent(context, AniTorrentService.actualServiceClass),
+            conn,
+            Context.BIND_ABOVE_CLIENT,
+        )
+        if (!bindResult) throw ServiceStartException.BindServiceFailed()
+        logger.debug { "[3/4] Bound service successfully." }
+
+        val result = newDeferred.await()
+        logger.debug { "[4/4] Got service binder: $result" }
+        return result
+    }
+
+    private suspend fun awaitStartupBroadcast() {
         suspendCancellableCoroutine { cont ->
             val receiver = object : BroadcastReceiver() {
                 override fun onReceive(c: Context?, intent: Intent?) {
@@ -98,20 +127,9 @@ class AniTorrentServiceStarter(
                 logger.debug { "[1/4] Started service, result: $startResult" }
             }
         }
-    
-        val newDeferred = CompletableDeferred<IRemoteAniTorrentEngine>()
-        binderDeferred.value = newDeferred
-
-        val bindResult = context.bindService(
-            Intent(context, AniTorrentService.actualServiceClass),
-            conn,
-            Context.BIND_ABOVE_CLIENT,
-        )
-        if (!bindResult) throw ServiceStartException.BindServiceFailed()
-        logger.debug { "[3/4] Bound service successfully." }
+    }
 
-        val result = newDeferred.await()
-        logger.debug { "[4/4] Got service binder: $result" }
-        return result
+    private companion object {
+        val STARTUP_BROADCAST_TIMEOUT = 15.seconds
     }
 }
\ No newline at end of file
