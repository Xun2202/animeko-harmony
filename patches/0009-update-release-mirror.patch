From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Tue, 6 Oct 2026 18:30:32 +0000
Subject: [PATCH] update: read the fork release list from the repo-branch
 mirror first

Checking for updates listed the fork's releases through api.github.com,
whose anonymous quota is 60 requests per hour per IP address. Phones
behind carrier NAT or a shared proxy exhaust it within minutes and the
check fails with HTTP 403.

The fork's CI now mirrors the "list releases" response to the `repo`
branch of the release repository (releases.json). Read it from
raw.githubusercontent.com first (a plain CDN, no such quota) and fall
back to the API when the mirror is unreachable.
---
 .../kotlin/ui/update/HarmonyForkUpdates.kt    | 39 ++++++++++++++++---
 1 file changed, 33 insertions(+), 6 deletions(-)

diff --git a/app/shared/ui-settings/src/commonMain/kotlin/ui/update/HarmonyForkUpdates.kt b/app/shared/ui-settings/src/commonMain/kotlin/ui/update/HarmonyForkUpdates.kt
index 90b99fa..0ecf84e 100644
--- a/app/shared/ui-settings/src/commonMain/kotlin/ui/update/HarmonyForkUpdates.kt
+++ b/app/shared/ui-settings/src/commonMain/kotlin/ui/update/HarmonyForkUpdates.kt
@@ -14,10 +14,13 @@ import io.ktor.client.request.get
 import io.ktor.client.request.header
 import io.ktor.client.request.parameter
 import io.ktor.client.statement.bodyAsText
+import kotlinx.coroutines.CancellationException
 import kotlinx.serialization.SerialName
 import kotlinx.serialization.Serializable
 import kotlinx.serialization.builtins.ListSerializer
 import kotlinx.serialization.json.Json
+import me.him188.ani.utils.logging.logger
+import me.him188.ani.utils.logging.warn
 import me.him188.ani.utils.platform.Arch
 
 /**
@@ -74,6 +77,35 @@ internal class GitHubRelease(
 
 private val githubJson = Json { ignoreUnknownKeys = true }
 
+private val logger = logger("HarmonyForkUpdates")
+
+/**
+ * The fork's CI mirrors the GitHub "list releases" response to the `repo` branch of the release repository.
+ * raw.githubusercontent.com is a plain CDN without the anonymous api.github.com quota of 60 requests per hour
+ * per IP, which phones behind carrier NAT or a shared proxy exhaust within minutes (HTTP 403).
+ */
+internal const val HARMONY_FORK_RELEASES_MIRROR =
+    "https://raw.githubusercontent.com/$HARMONY_FORK_REPO/repo/releases.json"
+
+/**
+ * Lists the fork's recent releases: mirror first, GitHub API as the fallback for when the mirror is
+ * unreachable or has not been written yet.
+ */
+internal suspend fun HttpClient.listHarmonyForkReleases(): List<GitHubRelease> {
+    val serializer = ListSerializer(GitHubRelease.serializer())
+    return try {
+        githubJson.decodeFromString(serializer, get(HARMONY_FORK_RELEASES_MIRROR).bodyAsText())
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        logger.warn(e) { "Release mirror unavailable, falling back to the GitHub API" }
+        get("https://api.github.com/repos/$HARMONY_FORK_REPO/releases") {
+            parameter("per_page", 30)
+            header("Accept", "application/vnd.github+json")
+        }.bodyAsText().let { githubJson.decodeFromString(serializer, it) }
+    }
+}
+
 /**
  * Returns the newest fork release newer than [current], or `null` when [current] is already the latest.
  */
@@ -81,12 +113,7 @@ internal suspend fun HttpClient.getHarmonyForkLatestVersion(
     current: HarmonyForkVersion,
     arch: Arch,
 ): NewVersion? {
-    val releases = get("https://api.github.com/repos/$HARMONY_FORK_REPO/releases") {
-        parameter("per_page", 30)
-        header("Accept", "application/vnd.github+json")
-    }.bodyAsText().let {
-        githubJson.decodeFromString(ListSerializer(GitHubRelease.serializer()), it)
-    }
+    val releases = listHarmonyForkReleases()
 
     val newer = releases.asSequence()
         .filter { !it.draft }
